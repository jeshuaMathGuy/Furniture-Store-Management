# Local-only development values. Never reuse these anywhere else.
# Your local MySQL server (8.0+). The root password is used only by setup/reset/tests.
MYSQL_ROOT_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
APP_DB_NAME=furni_form_app
LAB_DB_NAME=furniture_lab_db
TEACHING_DB_NAME=furniture_teaching
APP_DB_USER=furni_app
APP_DB_PASSWORD=furni_app_local
LAB_READER_USER=lab_reader
LAB_READER_PASSWORD=lab_reader_local
LAB_OPERATOR_USER=lab_operator
LAB_OPERATOR_PASSWORD=lab_operator_local
# Password given to every seeded demo account (see docs/database/DEMO_ACCOUNTS.md)
DEMO_ACCOUNT_PASSWORD=FurniForm-demo-2026
